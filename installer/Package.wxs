<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- One-click install: no wizard pages, just the UAC prompt and a progress bar. Per-machine because the
       app already runs elevated. The version comes from Houston.exe, so bumping <Version> in the app's
       csproj is all a new release needs. -->
  <Package
    Name="Houston"
    Manufacturer="Houston"
    Version="!(bind.FileVersion.HoustonExe)"
    UpgradeCode="093DDFBB-1E2A-419E-991F-F774C081905B"
    Scope="perMachine"
    Language="3082"
    Codepage="1252">

    <!-- A newer (or rebuilt) package replaces the installed one; never two copies side by side. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Ya hay instalada una versión más reciente de Houston." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="Houston.ico" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="Houston.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Houston" />
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="PawnIOOwnership" />
    </Feature>

    <!-- PawnIO: the kernel driver LibreHardwareMonitor needs for CPU temperatures. Its official installer
         travels inside this MSI and runs silently, so users never deal with it. PawnIO can be shared with
         other tools (FanControl, LibreHardwareMonitor...), so Houston only removes it if Houston put it there. -->
    <Binary Id="PawnIOSetup" SourceFile="$(PawnIOSetup)" />

    <!-- Present when PawnIO is installed; its setup registers this key (and refuses to install over it). -->
    <Property Id="PAWNIO_FOUND">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PawnIO"
                      Name="DisplayVersion" Type="raw" Bitness="always64" />
    </Property>
    <!-- Set when an earlier Houston installed PawnIO; read before a major upgrade removes the old version. -->
    <Property Id="HOUSTON_OWNS_PAWNIO">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\Houston" Name="InstalledPawnIO" Type="raw" Bitness="always64" />
    </Property>

    <!-- Ownership marker: written when Houston installs PawnIO, and carried over by upgrades. -->
    <Component Id="PawnIOOwnership" Directory="INSTALLFOLDER" Bitness="always64"
               Condition="NOT PAWNIO_FOUND OR HOUSTON_OWNS_PAWNIO">
      <RegistryValue Root="HKLM" Key="SOFTWARE\Houston" Name="InstalledPawnIO" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Return="ignore": without PawnIO Houston still works (temperatures show "—"), so a driver problem
         must never fail or roll back the install. A pending reboot (3010) is left to Windows. -->
    <CustomAction Id="InstallPawnIO" BinaryRef="PawnIOSetup" ExeCommand="-install -silent"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="UninstallPawnIO" BinaryRef="PawnIOSetup" ExeCommand="-uninstall -silent"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="InstallPawnIO" Before="InstallFinalize"
              Condition="NOT PAWNIO_FOUND AND NOT REMOVE" />
      <!-- Not during an upgrade: the new version keeps using the same PawnIO. -->
      <Custom Action="UninstallPawnIO" Before="InstallFinalize"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND HOUSTON_OWNS_PAWNIO AND PAWNIO_FOUND" />
    </InstallExecuteSequence>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <!-- Authored by hand so its Id can feed the package version above. The Start menu shortcut, the
           only thing outside the install folder, hangs off the exe so it is removed along with it. -->
      <Component>
        <File Id="HoustonExe" Source="$(PublishDir)Houston.exe" KeyPath="yes">
          <Shortcut
            Id="HoustonShortcut"
            Directory="ProgramMenuFolder"
            Name="Houston"
            Description="Monitor de CPU y GPU"
            WorkingDirectory="INSTALLFOLDER"
            Advertise="yes"
            Icon="Houston.ico" />
        </File>
      </Component>
      <Files Include="$(PublishDir)**">
        <Exclude Files="$(PublishDir)Houston.exe" />
        <Exclude Files="$(PublishDir)**\*.pdb" />
        <Exclude Files="$(PublishDir)**\*.xml" />
      </Files>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder" />
  </Package>
</Wix>
