<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Houston</AssemblyName>
    <RootNamespace>Houston.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from ui/src/assets/saturn-v.svg by tools/build-icon.ps1. -->
    <ApplicationIcon>Assets\houston.ico</ApplicationIcon>
    <!-- Required by the LibraryImport source generator. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Loaded from disk by the tray icon (LoadImage), at the exact small-icon size. -->
    <Content Include="Assets\houston.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
