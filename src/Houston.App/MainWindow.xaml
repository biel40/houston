<Window x:Class="Houston.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Houston"
        Width="300" Height="330"
        Left="100" Top="100"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        ShowActivated="False"
        Topmost="True">
    <!-- Alpha 1/255 instead of fully transparent: a layered window is hit-tested on its own alpha,
         so a zero-alpha background would let clicks fall through the WebView2 to the desktop. -->
    <Window.Background>
        <SolidColorBrush Color="#01000000" />
    </Window.Background>
    <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="Transparent" />
</Window>
